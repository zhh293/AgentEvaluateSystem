# AgentEvaluateSystem 环境变量模板
# 复制此文件为 .env 并修改配置

# 应用
DEBUG=true
ENVIRONMENT=development

# 数据库
DATABASE_URL=postgresql+asyncpg://agenteval:devpass@localhost:5432/agent_eval

# Redis
REDIS_URL=redis://localhost:6379/0

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672//

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=agent-eval

# JWT
JWT_SECRET_KEY=change-me-in-production

# LLM-as-Judge（系统自有密钥，用于 AI 类型识别等系统功能）
JUDGE_API_KEY=sk-your-openai-key
JUDGE_API_BASE=https://api.openai.com/v1
CASE_COUNCIL_MODELS=gpt-4o,gpt-4o-mini,o3-mini
CASE_COUNCIL_CHAIR_MODEL=gpt-4o
CASE_COUNCIL_MIN_REVIEWERS=2
MODEL_ENDPOINT_ALLOWED_DOMAINS=api.openai.com,api.anthropic.com,api.deepseek.com,dashscope.aliyuncs.com,open.bigmodel.cn,api.moonshot.cn

# Agent 镜像构建与运行
# 生产环境必须指向独立的 rootless BuildKit/Docker builder，不能使用运行时 Docker Socket。
AGENT_BUILDER_DOCKER_HOST=
AGENT_IMAGE_REPOSITORY=agenteval/submission
AGENT_IMAGE_PUSH=false
AGENT_REGISTRY_USERNAME=
AGENT_REGISTRY_PASSWORD=
AGENT_BUILD_NETWORK_MODE=none
AGENT_TRIVY_PATH=
# 声明 allowed_domains 时必须配置实施域名白名单的出口代理。
AGENT_EGRESS_PROXY=http://agenteval-egress:3128
AGENT_EGRESS_PROXY_CONTAINER=agenteval-egress-proxy
AGENT_EGRESS_PROXY_IMAGE=agenteval/egress-proxy:latest
AGENT_EGRESS_ALLOWED_DOMAINS=api.openai.com,api.anthropic.com,api.deepseek.com,dashscope.aliyuncs.com,open.bigmodel.cn,api.moonshot.cn
AGENT_RUNTIME_USER=65532:65532
AGENT_RUNTIME_LOW=
AGENT_RUNTIME_MEDIUM=
AGENT_RUNTIME_HIGH=
