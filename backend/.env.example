# AgentEvaluateSystem 环境变量模板
# 复制此文件为 .env 并修改配置

# 应用
DEBUG=true
ENVIRONMENT=development

# 数据库
DATABASE_URL=postgresql+asyncpg://agenteval:devpass@localhost:5432/agent_eval

# Redis
REDIS_URL=redis://localhost:6379/0

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672//

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=agent-eval

# JWT
JWT_SECRET_KEY=change-me-in-production

# LLM-as-Judge（系统自有密钥，用于 AI 类型识别等系统功能）
JUDGE_API_KEY=sk-your-openai-key
JUDGE_API_BASE=https://api.openai.com/v1
